# ==============================================================================
# Bodywise AI Companion — Backend Environment Configuration Example
# ==============================================================================

# Application Metadata
PROJECT_NAME="Bodywise AI Companion"

# Database Configuration
# Local development fallback (SQLite file is created automatically on startup):
DATABASE_URL=sqlite:///./bodywise.db
# PostgreSQL example for production / docker:
# DATABASE_URL=postgresql://user:password@localhost:5432/bodywise_db

# Security & Session Authentication
SECRET_KEY=replace_with_a_secure_random_secret_key_minimum_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Orchestration & Provider Settings
# When DEMO_MODE is true, the application runs fully functional deterministic multi-agent
# workflows and RAG vector searches with zero external API dependencies.
DEMO_MODE=true

# Google Gemini API Key (Optional)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# When provided and DEMO_MODE=false, enables live Gemini 1.5 Flash grounded synthesis.
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (comma-separated for production frontend, e.g. https://bodywise.vercel.app)
ALLOWED_ORIGINS=*

