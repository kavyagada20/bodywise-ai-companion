# ==============================================================================
# Bodywise AI Companion — Root Environment Configuration Example
# ==============================================================================

# Backend Configuration
PROJECT_NAME="Bodywise AI Companion"
DATABASE_URL=sqlite:///./bodywise.db
SECRET_KEY=replace_with_a_secure_random_secret_key_minimum_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Provider Settings
# Set to 'true' to run fully deterministically without requiring an API key
DEMO_MODE=true
# Google Gemini API Key from Google AI Studio (optional):
GEMINI_API_KEY=your_gemini_api_key_here
ALLOWED_ORIGINS=*

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
